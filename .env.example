# Gemini API Key (Required) - get it at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Azure Speech (Microsoft TTS - free tier: 500k chars/month)
VITE_AZURE_SPEECH_KEY=your-azure-speech-key-here
VITE_AZURE_REGION=eastus

# Google OAuth (for login with Google)
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_GOOGLE_CLIENT_SECRET=your-google-client-secret
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173

# ElevenLabs (Optional - premium voice)
VITE_ELEVENLABS_API_KEY=

# Supabase (Required)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
